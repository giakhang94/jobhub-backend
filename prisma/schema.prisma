// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}
//enum
enum Role {
  CANDIDATE
  RECRUITER
  ADMIN
}
enum UserStatus {
  PENDING
  ACTIVE
  BLOCKED
}

//enum for post table
enum PostStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
  PENDING
  REJECTED
}

enum FileType {
    IMAGE
    DOCUMENT
}

enum Privacy {
  FOLLOWER
  PUBLIC
  PRIVATE
}

//enum for notification
enum NotificationType {
  LIKE
  SHARE
  FOLLOW
  COMMENT
  REPLY 
  GROUP_JOIN_REQUEST
  GROUP_JOINED
  GROUP_JOIN_REQUEST_APPROVED
  GROUP_KICKED
  GROUP_PERMISSION_UPDATED
  GROUP_OWNERSHIP_TRANSFERRED
}

//enum for group module
enum GroupPrivacy {
  PUBLIC
  PRIVATE
}

enum GroupRole {
  OWNER
  MODERATOR
  MEMBER
}

enum JoinRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

//User table
model User {
  id          Int         @id @default(autoincrement())
  email       String      @unique
  password    String
  fullname    String      @map("full_name")
  avatar     String?

  //for various verification and authentication purposes
  emailVerificationToken String?     @map("email_verification_token")
  emailVerificationTokenExpiry DateTime? @map("email_verification_token_expiry")
  
  refreshTokenHash String?     @map("refresh_token_hash")
  role        Role        @default(CANDIDATE)
  status      UserStatus  @default(PENDING)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  // profile     Profile?
  // applications Application[]

  //keys
  posts Post[]
  uploadedFiles File[] @relation("UserUploadedFiles")
  @@map("users")

  //N-N relations
  followers Follow[] @relation("MyFollowers") //my followers
  following Follow[] @relation("MyFollowings") //my followings

  like Like[]
  comment Comment[]

  //N-1 relation with notification table
  senderNotifications Notification[]  @relation("Sender")
  receiverNotifications Notification[]  @relation("Receiver")

  //1-N with the groupMember table
  userInGroup GroupMember[] @relation("UserInGroup")
  joinRequest JoinRequest[] @relation("JoinRequest")

}

model Category {
  id Int @id @default(autoincrement())
  name String @unique
  posts Post[]
}

model Post {
  id Int @id @default(autoincrement())
  title String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  slug String @db.Text
  status PostStatus @default(PUBLISHED)
  viewCount Int @default(0)
  content String @db.Text
  privacy Privacy @default(PUBLIC)
  isPinned Boolean? @default(false)

  //Foreign Keys
  createdById Int
  createdBy User @relation(fields: [createdById], references: [id], onDelete: Cascade)

  categoryId Int
  category Category @relation(fields: [categoryId], references: [id])

  //1-N relationships
  files File[] @relation("PostBelongsFiles")
  likes Like[]
  comments Comment[]

  //for share post
  originalPostId Int?

  //1-N relation for sharing posts
  originalPost Post? @relation("PostShares", fields: [originalPostId], references: [id], onDelete: SetNull)
  sharedPosts Post[] @relation("PostShares")
  postsNotification Notification[] @relation("PostNotification")

  //relation with groups
  groupId Int?
  group Group? @relation("PostsInGroup", fields: [groupId], references: [id], onDelete: Cascade )
}

model File {
  id Int @id @default(autoincrement())
  url String
  publicId String? //Id file on Cloud (use for deleting file if needed)
  originalName String //original name of this file
  mimeType String //'image/png' or 'application/pdf'
  fileType  FileType //IMAGE hoac Document

  //foreign key
  //file links with user who upload it
  uploaderId Int
  uploader User @relation("UserUploadedFiles", fields: [uploaderId], references: [id], onDelete: Cascade)

  //which post that the files belong with
  postId Int?
  post Post? @relation("PostBelongsFiles", fields: [postId], references: [id], onDelete: Cascade)


  //which comment that th files belong with
  commentId Int? @unique
  comment Comment? @relation(fields: [commentId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

model Follow {
  followerId Int //id of users who click follow others
  followingId Int //id of users who have been followed by others

  //khoa ngoai
  follower User @relation("MyFollowers", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("MyFollowings", fields: [followingId], references: [id], onDelete: Cascade)

  @@id([followerId, followingId]) //the primary key includes 2 columns to avoid duplication
}

model Like {
  userId Int //id of the user who likes a post
  postId Int //id of the post that was liked by the above user

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@id([userId, postId])
}

model Comment {
  id Int @id @default(autoincrement()) @unique
  userId Int
  postId Int
  content String @db.Text

  //1-level nested comment
  parentId Int?  //null = parent Comment, has an ID => child comments

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  //relation with post and user
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  //self-relation for nested comment
  parent Comment? @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies Comment[] @relation("CommentReplies")


  //relation with file (upload file in the comment)
  file File?  

}

//NOTIFICATION
model Notification {
  id  Int @id @default(autoincrement())
  senderId Int
  receiverId Int
  type NotificationType
  postId Int?
  groupId Int?
  commentId Int?
  isRead Boolean @default(false)
  createdAt DateTime @default(now())

  //1-N relations
  group Group? @relation("GroupNotification", fields: [groupId], references: [id], onDelete: Cascade)
  sender User @relation("Sender", fields: [senderId],  references: [id], onDelete: Cascade)
  receiver User @relation("Receiver", fields: [receiverId], references: [id], onDelete: Cascade)
  post  Post?   @relation("PostNotification", fields: [postId], references: [id], onDelete: Cascade)
}

//GROUP
model Group {
  id Int @id @default(autoincrement())
  name String
  description String?
  coverPhoto String?
  privacy GroupPrivacy @default(PUBLIC)
  requireApprove Boolean @default(false)
  createdById Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  //relation
  posts Post[] @relation("PostsInGroup")
  notification Notification[] @relation("GroupNotification")
  groupMembers GroupMember[] @relation("GroupBelongsUser")
  joinRequests JoinRequest[] @relation("JoinRequest")
}

//group member generated from the N-N relation of the Group table and the user table
model GroupMember {
  userId Int
  groupId Int
  role GroupRole @default(MEMBER)
  canApproveMember Boolean @default(false)
  canDeletePost Boolean @default(false)
  canApprovePost Boolean @default(false) 
  canPinPost Boolean @default(false)
  canKickMember Boolean @default(false) 
  joinedAt DateTime @default(now())
  @@id([userId, groupId]) 
  //relation with user table N-1
  user User @relation("UserInGroup", fields: [userId], references: [id], onDelete: Cascade)
  group Group @relation("GroupBelongsUser", fields: [groupId], references: [id], onDelete: Cascade)
}

//model join requests
model JoinRequest {

  userId Int
  groupId Int
  requestStatus JoinRequestStatus @default(PENDING)
  createdAt DateTime @default(now())

  @@id([userId, groupId])
  //relation with user (N-1)
  user User @relation("JoinRequest", fields: [userId], references: [id], onDelete: Cascade)
  //relation with group (N-1)
  group Group @relation("JoinRequest", fields: [groupId], references: [id], onDelete: Cascade)

}