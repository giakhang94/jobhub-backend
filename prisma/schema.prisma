// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}
//enum
enum Role {
  CANDIDATE
  RECRUITER
  ADMIN
}
enum UserStatus {
  PENDING
  ACTIVE
  BLOCKED
}

//enum for post table
enum PostStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum FileType {
    IMAGE
    DOCUMENT
}

enum Privacy {
  FOLLOWER
  PUBLIC
  PRIVATE
}

//User table
model User {
  id          Int         @id @default(autoincrement())
  email       String      @unique
  password    String
  fullname    String      @map("full_name")
  avatar     String?

  //for various verification and authentication purposes
  emailVerificationToken String?     @map("email_verification_token")
  emailVerificationTokenExpiry DateTime? @map("email_verification_token_expiry")
  
  refreshTokenHash String?     @map("refresh_token_hash")
  role        Role        @default(CANDIDATE)
  status      UserStatus  @default(PENDING)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  // profile     Profile?
  // applications Application[]

  //keys
  posts Post[]
  uploadedFiles File[] @relation("UserUploadedFiles")
  @@map("users")
}

model Category {
  id Int @id @default(autoincrement())
  name String @unique
  posts Post[]
}

model Post {
  id Int @id @default(autoincrement())
  title String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  slug String @db.Text
  status PostStatus @default(PUBLISHED)
  viewCount Int @default(0)
  content String @db.Text
  privacy Privacy @default(PUBLIC)

  //Foreign Keys
  createdById Int
  createdBy User @relation(fields: [createdById], references: [id], onDelete: Cascade)

  categoryId Int
  category Category @relation(fields: [categoryId], references: [id])

  //1-N relationships
  files File[] @relation("PostBelongsFiles")

}

model File {
  id Int @id @default(autoincrement())
  url String
  publicId String? //Id file on Cloud (use for deleting file if needed)
  originalName String //original name of this file
  mimeType String //'image/png' or 'application/pdf'
  fileType  FileType //IMAGE hoac Document

  //foreign key
  //file links with user who upload it
  uploaderId Int
  uploader User @relation("UserUploadedFiles", fields: [uploaderId], references: [id], onDelete: Cascade)

  //which post that the files belong with
  postId Int?
  post Post? @relation("PostBelongsFiles", fields: [postId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}