// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}
//enum
enum Role {
  CANDIDATE
  RECRUITER
  ADMIN
}
enum UserStatus {
  PENDING
  ACTIVE
  BLOCKED
}

//enum for post table
enum PostStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum FileType {
    IMAGE
    DOCUMENT
}

enum Privacy {
  FOLLOWER
  PUBLIC
  PRIVATE
}

//User table
model User {
  id          Int         @id @default(autoincrement())
  email       String      @unique
  password    String
  fullname    String      @map("full_name")
  avatar     String?

  //for various verification and authentication purposes
  emailVerificationToken String?     @map("email_verification_token")
  emailVerificationTokenExpiry DateTime? @map("email_verification_token_expiry")
  
  refreshTokenHash String?     @map("refresh_token_hash")
  role        Role        @default(CANDIDATE)
  status      UserStatus  @default(PENDING)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  // profile     Profile?
  // applications Application[]

  //keys
  posts Post[]
  uploadedFiles File[] @relation("UserUploadedFiles")
  @@map("users")

  //N-N relations
  followers Follow[] @relation("MyFollowers") //my followers
  following Follow[] @relation("MyFollowings") //my followings

  like Like[]
  comment Comment[]
}

model Category {
  id Int @id @default(autoincrement())
  name String @unique
  posts Post[]
}

model Post {
  id Int @id @default(autoincrement())
  title String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  slug String @db.Text
  status PostStatus @default(PUBLISHED)
  viewCount Int @default(0)
  content String @db.Text
  privacy Privacy @default(PUBLIC)

  //Foreign Keys
  createdById Int
  createdBy User @relation(fields: [createdById], references: [id], onDelete: Cascade)

  categoryId Int
  category Category @relation(fields: [categoryId], references: [id])

  //1-N relationships
  files File[] @relation("PostBelongsFiles")
  likes Like[]
  comments Comment[]

  //for share post
  originalPostId Int?

  //1-N relation for sharing posts
  originalPost Post? @relation("PostShares", fields: [originalPostId], references: [id], onDelete: SetNull)
  sharedPosts Post[] @relation("PostShares")
}

model File {
  id Int @id @default(autoincrement())
  url String
  publicId String? //Id file on Cloud (use for deleting file if needed)
  originalName String //original name of this file
  mimeType String //'image/png' or 'application/pdf'
  fileType  FileType //IMAGE hoac Document

  //foreign key
  //file links with user who upload it
  uploaderId Int
  uploader User @relation("UserUploadedFiles", fields: [uploaderId], references: [id], onDelete: Cascade)

  //which post that the files belong with
  postId Int?
  post Post? @relation("PostBelongsFiles", fields: [postId], references: [id], onDelete: Cascade)


  //which comment that th files belong with
  commentId Int? @unique
  comment Comment? @relation(fields: [commentId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

model Follow {
  followerId Int //id of users who click follow others
  followingId Int //id of users who have been followed by others

  //khoa ngoai
  follower User @relation("MyFollowers", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("MyFollowings", fields: [followingId], references: [id], onDelete: Cascade)

  @@id([followerId, followingId]) //the primary key includes 2 columns to avoid duplication
}

model Like {
  userId Int //id of the user who likes a post
  postId Int //id of the post that was liked by the above user

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@id([userId, postId])
}

model Comment {
  id Int @id @default(autoincrement()) @unique
  userId Int
  postId Int
  content String @db.Text

  //1-level nested comment
  parentId Int?  //null = parent Comment, has an ID => child comments

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  //relation with post and user
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  //self-relation for nested comment
  parent Comment? @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies Comment[] @relation("CommentReplies")


  //relation with file (upload file in the comment)
  file File?  

}